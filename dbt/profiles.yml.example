# Copy this file to ~/.dbt/profiles.yml before running dbt.
# Install the pinned adapter from requirements.txt.
# Supply all credentials through environment variables.

oulad_project:
  target: dev
  outputs:
    dev:
      type: databricks
      catalog: open_university
      schema: "{{ env_var('DBT_SCHEMA', 'oulad_gold_dev') }}"
      host: "{{ env_var('DATABRICKS_HOST') }}"
      http_path: "{{ env_var('DATABRICKS_HTTP_PATH') }}"
      token: "{{ env_var('DBT_ENV_SECRET_DATABRICKS_TOKEN') }}"
      threads: 4
    production:
      type: databricks
      catalog: open_university
      schema: "{{ env_var('DBT_SCHEMA', 'oulad_gold') }}"
      host: "{{ env_var('DATABRICKS_HOST') }}"
      http_path: "{{ env_var('DATABRICKS_HTTP_PATH') }}"
      auth_type: oauth
      client_id: "{{ env_var('DATABRICKS_CLIENT_ID') }}"
      client_secret: "{{ env_var('DATABRICKS_CLIENT_SECRET') }}"
      threads: 4
